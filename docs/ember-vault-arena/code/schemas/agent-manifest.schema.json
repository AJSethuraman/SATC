{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dungeon.local/schemas/agent-manifest.schema.json",
  "title": "Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "system_prompt",
    "personality",
    "strategy",
    "build",
    "secret_objective"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 40,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {"type": "string", "minLength": 2, "maxLength": 40},
    "system_prompt": {"type": "string", "minLength": 10, "maxLength": 2000},
    "personality": {"type": "string", "minLength": 3, "maxLength": 500},
    "strategy": {"type": "string", "minLength": 3, "maxLength": 1000},
    "build": {
      "type": "string",
      "enum": ["vanguard", "scout", "mystic", "scoundrel"]
    },
    "secret_objective": {
      "type": "string",
      "enum": [
        "monster_hunter",
        "lorekeeper",
        "oathbreaker",
        "treasure_hoarder"
      ]
    }
  }
}

