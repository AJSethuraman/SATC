{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-dungeon.local/schemas/agent-action.schema.json",
  "title": "Agent Action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "target",
    "destination",
    "item",
    "speech",
    "reasoning_summary",
    "memory_write"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["move", "attack", "guard", "search", "interact", "take", "use", "rest"]
    },
    "target": {"type": ["string", "null"], "maxLength": 64},
    "destination": {"type": ["string", "null"], "maxLength": 32},
    "item": {"type": ["string", "null"], "maxLength": 64},
    "speech": {"type": "string", "maxLength": 120},
    "reasoning_summary": {"type": "string", "maxLength": 240},
    "memory_write": {"type": "string", "maxLength": 160}
  }
}

