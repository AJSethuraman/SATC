        {
         "key": "amt",
         "label": "Amount",
         "type": "number",
         "req": true,
         "money": true,
         "cents": true
        }
       ]
      },
      "cellsBy": "col"
     }
    ]
   },
   {
    "id": "s4",
    "title": "Sign-off",
    "mode": "required",
    "blocks": [
