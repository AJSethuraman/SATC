{
 "pack": {
  "name": "Control test",
  "version": "2.0"
 },
 "brand": "3D4FC4",
 "org": {
  "name": "Northgate Audit (synthetic)",
  "lists": {
   "Yes / No": [
    "Yes",
    "No"
   ],
   "Frequency": [
    "Daily",
    "Weekly",
    "Monthly",
    "Quarterly",
    "Annual"
   ],
   "Conclusions": [
    "Operating effectively",
    "Operating with exceptions",
    "Not operating"
   ]
  }
 },
 "tool": {
  "name": "Control test",
  "sections": [
   {
    "id": "s1",
    "title": "The control",
    "mode": "required",
    "blocks": [
     {
      "kind": "field",
      "id": "control",
      "label": "Control",
      "type": "text",
      "req": true
     },
     {
      "kind": "field",
      "id": "owner",
      "label": "Control owner",
      "type": "text",
      "req": true
     },
     {
      "kind": "field",
      "id": "freq",
      "label": "How often it runs",
      "type": "list",
      "req": true,
      "list": "Frequency"
     },
     {
      "kind": "field",
      "id": "period",
      "label": "Period tested",
      "type": "text",
      "req": true
     },
     {
      "kind": "field",
      "id": "hasexc",
      "label": "Were exceptions found?",
      "type": "list",
      "req": true,
      "list": "Yes / No"
     }
    ]
   },
   {
    "id": "s2",
    "title": "Sample",
    "mode": "required",
    "blocks": [
     {
      "kind": "grid",
      "id": "sample",
      "label": "Payments tested",
      "rows": {
       "from": "entered",
       "min": 1
      },
      "cols": {
       "from": "fixed",
       "items": [
        {
         "key": "id",
         "label": "Payment",
         "type": "text",
         "req": true
        },
        {
         "key": "date",
         "label": "Date",
         "type": "date",
         "req": false
        },
        {
         "key": "amount",
         "label": "Amount",
         "type": "number",
         "req": false,
         "money": true,
         "noTotal": true
        },
        {
         "key": "a1",
         "label": "A1 Authorized approver",
         "type": "choice",
         "req": true,
         "opts": [
          "Pass",
          "Exception",
          "N/A"
         ]
        },
        {
         "key": "a2",
         "label": "A2 Approved first",
         "type": "choice",
         "req": true,
         "opts": [
          "Pass",
          "Exception",
          "N/A"
         ]
        },
        {
         "key": "a3",
         "label": "A3 Invoice on file",
         "type": "choice",
         "req": true,
         "opts": [
          "Pass",
          "Exception",
          "N/A"
         ]
        }
       ]
      },
      "cellsBy": "col"
     },
     {
      "kind": "calc",
      "id": "calc_dev",
      "method": "devrate",
      "grid": "sample",
      "attributes": [
       "a1",
       "a2",
       "a3"
      ],
      "code": "DEV-DEMO 1.0",
      "limit": 0.05,
      "limitLabel": "Highest deviation rate (tolerance)"
     }
    ]
   },
   {
    "id": "s3",
    "title": "Exceptions",
    "mode": "conditional",
    "rule": {
     "field": "hasexc",
     "values": [
      "Yes"
     ]
    },
    "blocks": [
     {
      "kind": "grid",
      "id": "exc",
      "label": "Exceptions and follow-up",
      "rows": {
       "from": "entered",
       "min": 1
      },
      "cols": {
       "from": "fixed",
       "items": [
        {
         "key": "pay",
         "label": "Payment",
         "type": "text",
         "req": true
        },
        {
         "key": "what",
         "label": "What happened",
         "type": "text",
         "req": true
        },
        {
         "key": "who",
         "label": "Owner",
         "type": "text",
         "req": true
        },
        {
         "key": "due",
         "label": "Due",
         "type": "date",
         "req": false
        }
       ]
      },
      "cellsBy": "col"
     }
    ]
   },
   {
    "id": "s4",
    "title": "Conclusion",
    "mode": "required",
    "blocks": [
     {
      "kind": "field",
      "id": "concl",
      "label": "Conclusion",
      "type": "list",
      "req": true,
      "list": "Conclusions"
     },
     {
      "kind": "field",
      "id": "summary",
      "label": "Summary",
      "type": "longtext",
      "req": true
     }
    ]
   }
  ]
 },
