# --- Required ---------------------------------------------------------------
# SEC fair-access rules require a declared User-Agent identifying you.
# Format: "Name or App (contact email)". Requests without it may be blocked.
SEC_USER_AGENT="stock-helper dev (you@example.com)"

# --- Optional ----------------------------------------------------------------
# Database URL. Defaults to a SQLite file under data/db/.
# STOCK_HELPER_DB_URL="sqlite:///data/db/stock_helper.db"

# Enable the optional (non-canonical) daily price connector. Prices unlock
# market multiples, margin of safety, beta, and the backtest. On by default.
# ENABLE_PRICE_DATA=true
# Price source: "auto" (Yahoo -> Stooq, default), "yahoo", or "stooq". Yahoo has
# wider coverage and no tight per-IP daily cap, so it is the better default for a
# large universe and the backtest.
# PRICE_SOURCE=auto

# Logging: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# SEC HTTP cache time-to-live in hours (0 disables reuse of cached responses).
# SEC_CACHE_TTL_HOURS=24

# --- Cost of capital --------------------------------------------------------
# FRED API key (https://fred.stlouisfed.org/docs/api/api_key.html). Supplies the
# risk-free rate (10-yr Treasury, series DGS10). Without it, RISK_FREE_DEFAULT
# is used instead.
# FRED_API_KEY=""

# Fallback risk-free rate (decimal fraction) used when FRED is unavailable.
# RISK_FREE_DEFAULT=0.042

# Equity risk premium (decimal fraction) assumption for CAPM. A long-run
# scenario input, not a market observation — labeled as such in outputs.
# EQUITY_RISK_PREMIUM=0.05
