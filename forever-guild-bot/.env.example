# Discord: https://discord.com/developers/applications -> your app -> Bot -> token
DISCORD_TOKEN=
# Your Discord server ID (makes slash commands appear instantly). Optional.
DISCORD_GUILD_ID=

# Blizzard: https://develop.battle.net -> API Access -> create client
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us

# Your guild's name as a slug: lowercase, spaces become dashes
GUILD_SLUG=

# Optional
# Comma-separated channel IDs the slash commands may be used in (blank = anywhere)
BOT_CHANNEL_IDS=
SYNC_MINUTES=60
TIMEZONE=America/New_York
DB_PATH=guildbot.sqlite3
